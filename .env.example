# Copia este archivo a backend\.env y pon tus valores reales.
# NUNCA commitees el .env.

# --- Planificador y auditor -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo del Planner. Por defecto claude-sonnet-5.
# ORACLE_PLANNER_MODEL=claude-sonnet-5

# Opcional: modelo del Sentinel. DEBE ser distinto al del Planner.
# ORACLE_SENTINEL_MODEL=claude-haiku-4-5-20251001

# --- Autenticacion del panel ------------------------------------------
# Genera un secreto nuevo (minimo 32 caracteres). NO hay valor por defecto:
# el servidor se niega a arrancar sin esto, a proposito.
#   python -m app.auth hash <tu-clave>
ORACLE_JWT_SECRET=

# Usuario del operador y hash argon2 de su clave (lo imprime el comando de arriba).
ORACLE_OPERATOR=
ORACLE_OPERATOR_HASH=

# La cookie de refresco solo viaja por HTTPS. Para desarrollo local sobre
# http://localhost hay que ponerlo a 0. NUNCA a 0 en produccion.
ORACLE_COOKIE_SECURE=0
